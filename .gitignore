# Build artifacts
/target/
# gpui frontend is its own workspace (root-excluded) — keep its artifacts out
/frontends/gpui/target/

# Re-enginering working area: decompiled Hollyland APK output and extracted
# bundles. NEVER commit — original code only in this repo (hard rule).
/re/
*.xapk

# Capture tooling scratch space (raw pcaps stay local; exported *.jsonl in
# captures/ are the evidence files we keep and cite in docs/protocol.md).
/captures/raw/
__pycache__/

# Android-x86 image + QEMU scratch disk (osfiles for APK runs): huge local
# binaries, NEVER commit — see tools/qemu-android.sh usage.
android-x86-9.0-r2.iso
tools/android-x86.qcow2
